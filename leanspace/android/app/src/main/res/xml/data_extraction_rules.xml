<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Daily Stitch backup / transfer rules.

        We do NOT include auth tokens, subscription state, or shared
        preferences in cloud or device-to-device backups. Tasks and
        habits are server-side so they re-sync from Supabase.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
