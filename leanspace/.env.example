# Copy this file to `.env` in the same directory (never commit `.env`).

# Cloudflare Workers API URL (from wrangler.toml or your deployed URL)
API_BASE_URL=https://daily-stitch-api.your-subdomain.workers.dev

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Phase 2+
# ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-xxx/yyy

# Phase 4+
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
